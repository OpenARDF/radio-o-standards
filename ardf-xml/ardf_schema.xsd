<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:iof="http://www.orienteering.org/datastandard/3.0"
  targetNamespace="http://rob-is.cz/datastandard/ardf/1.0"
  xmlns="http://rob-is.cz/datastandard/ardf/1.0"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified">

  <!-- IOF 3.0 schema (oficiální) -->
  <xs:import
      namespace="http://www.orienteering.org/datastandard/3.0"
      schemaLocation="https://raw.githubusercontent.com/international-orienteering-federation/datastandard-v3/master/IOF.xsd"/>

  <!-- ==========================
       ARDF: Course data pro ResultList/Extensions
  =========================== -->
  <xs:complexType name="CourseControlType">
    <xs:annotation>
      <xs:documentation>
        Jedna kontrola v trati. Atribut "type" rozlišuje:
        - Control   : normální kontrola
        - Separator : divácká kontrola
        - Beacon    : maják
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Control" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="type" use="optional">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="Control"/>
          <xs:enumeration value="Separator"/>
          <xs:enumeration value="Beacon"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="CourseType">
    <xs:sequence>
      <!-- M20, D20, W21, … -->
      <xs:element name="CourseFamily" type="xs:string"/>
      <xs:element name="CourseControl" type="CourseControlType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RaceCourseDataType">
    <xs:annotation>
      <xs:documentation>
        ARDF popis tratí pro jednotlivé kategorie, vkládaný typicky do
        ResultList/Extensions.

        Každá Course reprezentuje jednu kategorii (CourseFamily)
        a seznam CourseControl s typem Control / Separator / Beacon.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Course" type="CourseType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Globální element použitý v ResultList/Extensions -->
  <xs:element name="RaceCourseData" type="RaceCourseDataType"/>

  <!-- ==========================
       ARDF: ValidPunches pro Result/Extensions
  =========================== -->
  <xs:element name="ValidPunches" type="xs:integer">
    <xs:annotation>
      <xs:documentation>
        Počet správně nalezených kontrol v daném ARDF výsledku, včetně
        diváckých kontrol (Separator) a majáku (Beacon).

        Doporučené místo:
          - uvnitř iof:Result/iof:Extensions
      </xs:documentation>
    </xs:annotation>
  </xs:element>

</xs:schema>
